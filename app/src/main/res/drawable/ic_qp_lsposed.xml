<?xml version="1.0" encoding="utf-8"?>
<!-- 专属LSPosed：参照 LSPosed 标志，一条实心斜条 + 一条空心斜环交叉，中心四颗圆点 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 实心斜条：左下 → 右上，中间用四颗圆点挖空（evenOdd） -->
    <path
        android:fillColor="#000000"
        android:fillType="evenOdd"
        android:pathData="M6.24,21.44 L21.44,6.24 L17.76,2.56 L2.56,17.76 Z M11.15,10.9 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 Z M11.15,13.1 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 Z M10.9,11.15 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 Z M13.1,11.15 a0.85,0.85 0 1,0 1.7,0 a0.85,0.85 0 1,0 -1.7,0 Z" />

    <!-- 空心斜环：左上 → 右下，两端露出菱形孔 -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="45">
        <path
            android:fillColor="#00000000"
            android:pathData="M5.6,10.2 L18.4,10.2 A1.8,1.8 0 0 1 20.2,12 A1.8,1.8 0 0 1 18.4,13.8 L5.6,13.8 A1.8,1.8 0 0 1 3.8,12 A1.8,1.8 0 0 1 5.6,10.2 Z"
            android:strokeColor="#000000"
            android:strokeWidth="1.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
