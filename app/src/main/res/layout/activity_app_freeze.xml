<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/pick_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/page_header_row"
        android:background="@drawable/bg_header">

        <!-- 左侧：与全屏页同一套位置（14dp 内边距 + 44dp 触摸区）、同一套颜色 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp">

            <ImageButton
                android:id="@+id/back"
                style="@style/PageHeaderBack"
                android:layout_marginStart="0dp"
                android:contentDescription="返回"
                android:src="@drawable/ic_back" />
        </LinearLayout>

        <TextView
            android:id="@+id/title"
            style="@style/PageHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:layout_gravity="center"
            android:text="应用冻结" />

        <!-- 右上角：与全屏页「加号」同一位置（14dp 内边距 + 44dp 触摸区）；
             勾选应用后显示打勾确定。列表/宫格标识移到状态分段那一行右端 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="14dp">

            <ImageButton
                android:id="@+id/pick_done"
                style="@style/PageHeaderActionIcon"
                android:layout_marginEnd="0dp"
                android:contentDescription="完成添加至列表"
                android:src="@drawable/ic_pick_done"
                android:tint="@color/blue"
                android:visibility="gone" />

            <TextView
                android:id="@+id/batch"
                style="@style/PageHeaderAction"
                android:layout_marginEnd="0dp"
                android:text="批量" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp">

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="13dp"
            android:background="@drawable/bg_field_list"
            android:backgroundTint="@null"
            android:cursorVisible="false"
            android:drawableStart="@drawable/ic_sc_search"
            android:drawablePadding="6dp"
            android:hint="搜索应用名或包名"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="12dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/filter_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_blue_soft"
                android:paddingLeft="16dp"
                android:paddingTop="7dp"
                android:paddingRight="16dp"
                android:paddingBottom="7dp"
                android:text="用户应用"
                android:textColor="@color/tab_selected_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/filter_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_white"
                android:paddingLeft="16dp"
                android:paddingTop="7dp"
                android:paddingRight="16dp"
                android:paddingBottom="7dp"
                android:text="系统应用"
                android:textColor="@color/blue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 状态分段 + 列表/宫格标识：标识与这一行同高、靠右端，宫格模式下右缘对齐第一排最后一个图标 -->
        <FrameLayout
            android:id="@+id/view_mode_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/state_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_blue_soft"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:singleLine="true"
                android:text="全部"
                android:textColor="@color/tab_selected_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/state_frozen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_btn_white"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:singleLine="true"
                android:text="已冻结"
                android:textColor="@color/blue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/state_unfrozen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_btn_white"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:singleLine="true"
                android:text="未冻结"
                android:textColor="@color/blue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/state_in_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_btn_white"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:singleLine="true"
                android:text="已添加"
                android:textColor="@color/blue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/state_not_in_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_btn_white"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:singleLine="true"
                android:text="未添加"
                android:textColor="@color/blue"
                android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/view_mode"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="切换列表 / 宫格"
                android:focusable="false"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_qp_grid"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/sys_hint_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="13dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/sys_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="冻结系统应用可能影响系统功能"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/sys_hint_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="不再提示"
                android:textColor="@color/blue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/root_state_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="13dp">

            <TextView
                android:id="@+id/root_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/root_state_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="2dp"
                android:text="不再提示"
                android:textColor="@color/blue"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 选择应用：已选图标条，与下方大图标同列宽、左右边缘对齐，可折行 -->
    <LinearLayout
        android:id="@+id/pick_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="10dp"
            android:paddingEnd="23dp"
            android:paddingBottom="16dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/batch_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/page_bg"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_freeze"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_blue"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="一键冻结"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_unfreeze"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_white"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="一键解冻"
            android:textColor="@color/blue"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
