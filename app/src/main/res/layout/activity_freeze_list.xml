<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <!-- 背景只由 page_root 这一层承担：全屏背景滑块按档位改它的 alpha，内层不再叠第二层底色 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏：左侧 返回+解冻，右侧 减号+加号，标题以屏幕为基准绝对居中 -->
        <FrameLayout
            android:id="@+id/page_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/page_header_row"
            android:background="@drawable/bg_header">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp">

                <ImageButton
                    android:id="@+id/back"
                    style="@style/PageHeaderBack"
                    android:layout_marginStart="0dp"
                    android:contentDescription="返回"
                    android:src="@drawable/ic_back" />

                <ImageButton
                    android:id="@+id/btn_unfreeze"
                    style="@style/PageHeaderActionIcon"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:contentDescription="一键解冻"
                    android:src="@drawable/ic_unfreeze_small"
                    android:tint="@color/unlock_icon" />
            </LinearLayout>

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="冻结列表"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/page_header_title_size" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="14dp">

                <ImageButton
                    android:id="@+id/edit"
                    style="@style/PageHeaderActionIcon"
                    android:layout_marginEnd="0dp"
                    android:contentDescription="移除模式"
                    android:src="@drawable/ic_minus" />

                <ImageButton
                    android:id="@+id/add"
                    style="@style/PageHeaderActionIcon"
                    android:layout_marginEnd="0dp"
                    android:contentDescription="添加应用"
                    android:src="@drawable/ic_add" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp">

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field_list"
                android:backgroundTint="@null"
                android:hint="搜索名单里的应用"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingLeft="12dp"
                android:paddingTop="10dp"
                android:paddingRight="12dp"
                android:paddingBottom="10dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- 标签条：内置两个 + 自定义，横向可滚动，内容由代码按配置生成 -->
                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/tab_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="7dp"
                    android:text="布局"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/backup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="7dp"
                    android:text="备份"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/restore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="2dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="7dp"
                    android:text="恢复"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sys_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="冻结系统应用可能影响系统功能"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="100dp" />
        </ScrollView>
    </LinearLayout>

    <!-- 一键冻结：悬浮按钮，位置由布局设置里的两个滑块控制，滚动时保持可见 -->
    <LinearLayout
        android:id="@+id/fab_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fab_group"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/btn_freeze"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="一键冻结"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sc_freeze" />
    </LinearLayout>

    <!-- 长按冻结按钮浮出的一键解冻：单独一个浮层，位置由代码贴到冻结按钮正上方 -->
    <ImageButton
        android:id="@+id/btn_unfreeze_fab"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_fab_group"
        android:contentDescription="一键解冻"
        android:elevation="8dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sc_unfreeze"
        android:visibility="gone" />

</FrameLayout>
