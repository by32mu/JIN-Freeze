<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 二级页蓝色顶栏公共样式：尺寸全部走 dimens.xml，页面不要再写死数值 -->
    <style name="PageHeaderBack">
        <item name="android:layout_width">@dimen/page_header_touch</item>
        <item name="android:layout_height">@dimen/page_header_touch</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:padding">@dimen/page_header_back_padding</item>
        <item name="android:tint">@color/text_primary</item>
    </style>

    <style name="PageHeaderTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/page_header_row</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/page_header_title_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PageHeaderAction">
        <item name="android:layout_width">@dimen/page_header_touch</item>
        <item name="android:layout_height">@dimen/page_header_touch</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/page_header_action_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 顶栏右侧图标：与首页顶栏图标同一档（44dp 点击区 + 10dp 内边距 -> 24dp 图形） -->
    <style name="PageHeaderActionIcon">
        <item name="android:layout_width">@dimen/page_header_touch</item>
        <item name="android:layout_height">@dimen/page_header_touch</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/page_header_action_padding</item>
        <item name="android:tint">@color/text_primary</item>
    </style>

    <style name="PageHeaderSlot">
        <item name="android:layout_width">@dimen/page_header_touch</item>
        <item name="android:layout_height">@dimen/page_header_touch</item>
        <item name="android:layout_marginEnd">14dp</item>
    </style>
</resources>
