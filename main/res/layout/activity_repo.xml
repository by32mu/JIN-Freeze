<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back"
            style="@style/PageHeaderBack"
            android:contentDescription="返回"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/title"
            style="@style/PageHeaderTitle"
            android:text="模块仓库" />

        <ImageView
            android:id="@+id/action_icon"
            style="@style/PageHeaderActionIcon"
            android:contentDescription="添加源"
            android:src="@drawable/ic_add"
            android:visibility="gone" />

        <TextView
            android:id="@+id/action"
            style="@style/PageHeaderAction"
            android:text="刷新"
            android:visibility="gone" />
    </LinearLayout>

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="14dp"
        android:background="@drawable/bg_btn_soft"
        android:hint="搜索模块名称 / 描述 / 作者"
        android:inputType="text"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="14dp"
        android:paddingTop="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
