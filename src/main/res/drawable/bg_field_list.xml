<?xml version="1.0" encoding="utf-8"?>
<!-- 冻结列表的搜索框：与列表选中框同一套低饱和蓝灰；
     聚焦时描边加粗一档，既统一又能看出焦点 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_surface_bg" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/accent_surface_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_surface_bg" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/accent_surface_stroke_soft" />
        </shape>
    </item>
</selector>
