    <color name="text_secondary">#8A9099</color>
    <!-- 全屏界面里原来用灰色的入口/提示文字：浅色统一压成纯黑，深色下用高对比浅色保证看得清 -->
    <color name="fs_text_muted">#000000</color>
    <!-- 解冻图标：浅色模式纯黑，深色模式走高对比浅色 -->
    <color name="header_icon_black">#000000</color>
    <!-- 全屏左上角解锁图标：浅色下固定纯黑；深色下纯黑不可见，改用高对比浅色（形状不变） -->
    <color name="unlock_icon">#000000</color>
    <!-- 半屏浮层上方遮罩：透出桌面，同时保证底部面板可读 -->
    <color name="panel_scrim">#33000000</color>
    <!-- 启动/收起过渡的底色：系统启动窗口与 Splash 统一用深黑，避免闪白 -->
    <color name="launch_scrim">#111318</color>
    <color name="divider">#EDEFF3</color>
    <color name="soft_bg">#EBF1FE</color>
    <!-- 冻结列表的选中框 / 搜索框：低饱和蓝灰，和页面中性底色更贴，避免高饱和蓝跳出来 -->
    <color name="accent_surface_bg">#E8EDF5</color>
    <color name="accent_surface_stroke">#647A99</color>
    <color name="accent_surface_stroke_soft">#CDD7E5</color>
    <color name="sel_fill">#2E647A99</color>
    <!-- 全屏标签页选中态：低饱和浅蓝底 + 深蓝字，替代原来扎眼的高饱和蓝胶囊 -->
    <color name="tab_selected_bg">#DEE8FB</color>
    <color name="tab_selected_text">#2F5AD8</color>
